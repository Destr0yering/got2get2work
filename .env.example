# Optional. The app stays fully usable with its deterministic local demo when omitted.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4100
EXPO_PUBLIC_DEMO_MODE=true

# Server-only values. Never prefix the API key with EXPO_PUBLIC_.
# Set EXPO_PUBLIC_DEMO_MODE=false when intentionally exercising the live agent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
PORT=4100
ALLOWED_ORIGIN=http://localhost:8081
