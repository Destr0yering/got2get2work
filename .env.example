# Optional. The app stays fully usable with its deterministic local demo when omitted.
# Store builds must use the deployed HTTPS API. Localhost cannot serve a phone.
EXPO_PUBLIC_API_BASE_URL=https://api.got2get2work.example
EXPO_PUBLIC_DEMO_MODE=true

# Optional client-side Firebase configuration. For Android builds, either set
# all four values at bundle time or expose them from API_BASE_URL/api/config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Server-only values. Never prefix the API key with EXPO_PUBLIC_.
# Set EXPO_PUBLIC_DEMO_MODE=false when intentionally exercising the live agent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=4100
ALLOWED_ORIGIN=https://got2get2work.example
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=got2get2work-xprize-cloud
FIREBASE_WEB_APP_ID=
REQUIRE_AGENT_AUTH=false
